# Có thể sao chép thành .env.local để ghi đè cấu hình. Biến liên hệ rỗng hoặc sai định dạng sẽ không hiện liên kết
# (giao diện hiện "(đang cập nhật)"). Xem src/config/site.ts.

# URL gốc của site (Open Graph, metadata). Bỏ trống → https://bactraky.io.vn (khi `next dev` → http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://bactraky.io.vn

# Kênh liên hệ chính thức
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/bactraky/
NEXT_PUBLIC_CONTACT_EMAIL=bactraky@gmail.com
NEXT_PUBLIC_HOTLINE=0869189004
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@bactraky

# Kênh cho nút "Liên hệ đặt hàng" (URL http(s) hoặc đường dẫn nội bộ). Mặc định: /#lien-he
NEXT_PUBLIC_ORDER_CHANNEL_URL=

# Phase 05 (backend, làm sau) sẽ thêm:
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=bac-tra-ky
